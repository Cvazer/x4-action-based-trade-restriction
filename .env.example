# Copy to .env and fill in your own values. Not committed; read by the Justfile.

# The mod's own release version, X.Y.Z with an optional suffix.
MOD_VERSION=1.0.0

# The X4 installation to build and test against. Its version.dat becomes the extension's minimum
# game version. A path containing spaces must be quoted.
GAME_DIR="D:/SteamLibrary/steamapps/common/X4 Foundations"
