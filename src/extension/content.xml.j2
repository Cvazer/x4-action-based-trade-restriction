<?xml version="1.0" encoding="utf-8"?>
<content id="{{ id }}"
         name="{{ name }}"
         description="{{ description }}"
         author="{{ author }}"
         version="{{ content_version }}"
         date="{{ date }}"
         save="true">
  <dependency version="{{ game_version }}" />
  <dependency id="x4native" optional="false" name="X4Native" />
</content>
